type media-config-sh, domain;
type media-config-sh_exec, exec_type, vendor_file_type, file_type;

# transfer domain from init domain to media-config-sh domain
init_daemon_domain(media-config-sh)

# allow to access sys files
allow media-config-sh sysfs:dir { open read };
allow media-config-sh sysfs:file { getattr open read };

# allow to use /vendor/bin/
allow media-config-sh vendor_toolbox_exec:file execute_no_trans;

# allow setprop
set_prop(media-config-sh, vendor_public_default_prop)
